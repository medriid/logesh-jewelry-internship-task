# ─────────────────────────────────────────────────────────────────────────────
# Loupe — environment contract
#
# Copy to `.env.local` and fill in. Every variable here is parsed and validated
# by src/config/env.ts at boot; a bad value crashes the process with a readable
# error instead of failing at 3am inside a request handler.
#
# Generate the secrets:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# pglite   → in-process Postgres (WASM). No Docker, no cloud account, no setup.
#            This is the default so `npm run dev` works on a fresh clone.
# postgres → a real server. Required in production. Point DATABASE_URL at Neon,
#            Supabase, RDS, or a local instance.
DATABASE_DRIVER=pglite
PGLITE_PATH=./.pglite
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/loupe?sslmode=require

# ── Secrets ─────────────────────────────────────────────────────────────────
# HMAC key for CSRF tokens and for hashing client IPs before they reach the logs.
# Must be >= 32 chars of real entropy. Rotating it invalidates all CSRF tokens
# (harmless) but not sessions.
APP_SECRET=replace-me-with-openssl-rand-base64-48-output-not-this-string

# ── Password hashing (Argon2id) ─────────────────────────────────────────────
# Defaults are OWASP's 2024 floor: 19 MiB, 2 iterations, 1 lane. Raise memory
# first if you have headroom. Existing hashes keep working — the parameters are
# stored inside each PHC string and verified against, not assumed.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_IDLE_TTL_SECONDS=43200        # 12h without activity → expired
SESSION_ABSOLUTE_TTL_SECONDS=604800   # 7d since login → expired regardless

# ── Rate limiting ───────────────────────────────────────────────────────────
# Optional locally (falls back to an in-process limiter). REQUIRED in production:
# serverless instances do not share memory, so an in-memory limiter on Vercel
# means login is effectively unthrottled. Free tier: https://upstash.com
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── CORS ────────────────────────────────────────────────────────────────────
# Extra origins allowed to call the API with credentials. APP_URL is always
# allowed. Comma-separated, exact-match, no wildcards.
CORS_ALLOWED_ORIGINS=

# ── Image uploads (optional) ────────────────────────────────────────────────
# Browsers upload straight to Cloudinary using a short-lived signature minted by
# POST /api/v1/uploads/sign. Bytes never transit our server. Omit these and the
# upload endpoint returns 503 while the rest of the API works normally.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Seed data (used only by `npm run db:seed`) ──────────────────────────────
SEED_ADMIN_EMAIL=owner@loupe.jewelry
SEED_ADMIN_PASSWORD=change-this-immediately
